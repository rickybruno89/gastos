{
  "name": "gastapp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "prisma generate && node scripts/dev.mjs",
    "build": "prisma generate && react-router build && node scripts/build-server.mjs",
    "start": "NODE_ENV=${NODE_ENV:-production} node build/server/index.js",
    "typecheck": "prisma generate && react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "prisma generate && node --import tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:setup": "node scripts/setup-db-local.mjs",
    "db:reset": "node scripts/setup-db-local.mjs --reset && npm run db:migrate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:docker": "docker build -t gastapp:v2-local . && node scripts/smoke-docker.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-router/node": "7.18.4",
    "@tanstack/react-query": "5.90.21",
    "better-auth": "1.7.12",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "isbot": "5.1.40",
    "lucide-react": "^1.60.0",
    "pg": "8.22.0",
    "prisma": "7.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "7.18.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.9",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4"
  }
}
