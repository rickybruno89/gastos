generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model User {
  id            String                 @id
  name          String
  email         String                 @unique
  emailVerified Boolean                @default(false)
  image         String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  preferences   UserPreferences?
  expenseSeries MonthlyExpenseSeries[]
  auditEntries  AuditLog[]
  idempotency   IdempotencyKey[]

  @@map("user")
  @@schema("auth")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
  @@schema("auth")
}

model UserPreferences {
  userId    String   @id
  timeZone  String   @default("America/Argentina/Tucuman")
  locale    String   @default("es-AR")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

enum Currency {
  ARS
  USD

  @@schema("public")
}

// DUE/vencido se deriva de dueDate y la fecha del usuario; no se persiste.
enum OccurrenceStatus {
  PLANNED
  PAID

  @@schema("public")
}

model MonthlyExpenseSeries {
  id             String                     @id @default(uuid(7)) @db.Uuid
  ownerId        String
  name           String                     @db.VarChar(80)
  currency       Currency
  intervalMonths Int                        @default(1) @db.SmallInt
  firstPeriod    DateTime                   @db.Date
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(3)
  owner          User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  terms          MonthlyExpenseTerms[]
  occurrences    MonthlyExpenseOccurrence[]

  @@unique([id, ownerId])
  @@index([ownerId, firstPeriod])
  @@schema("public")
}

// Importe y vencimiento vigentes desde effectivePeriod hasta la siguiente versión.
model MonthlyExpenseTerms {
  id              String               @id @default(uuid(7)) @db.Uuid
  ownerId         String
  seriesId        String               @db.Uuid
  effectivePeriod DateTime             @db.Date
  amountMinor     BigInt
  dueDay          Int                  @db.SmallInt
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  series          MonthlyExpenseSeries @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([seriesId, effectivePeriod])
  @@schema("public")
}

model MonthlyExpenseOccurrence {
  id          String               @id @default(uuid(7)) @db.Uuid
  ownerId     String
  seriesId    String               @db.Uuid
  period      DateTime             @db.Date
  dueDate     DateTime             @db.Date
  amountMinor BigInt
  currency    Currency
  status      OccurrenceStatus     @default(PLANNED)
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  series      MonthlyExpenseSeries @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)
  payments    ExpensePayment[]

  @@unique([seriesId, period])
  @@unique([id, ownerId])
  @@index([ownerId, period])
  @@schema("public")
}

model ExpensePayment {
  id           String                   @id @default(uuid(7)) @db.Uuid
  ownerId      String
  occurrenceId String                   @db.Uuid
  paidOn       DateTime                 @db.Date
  channel      String?                  @db.VarChar(40)
  amountMinor  BigInt
  currency     Currency
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  revertedAt   DateTime?                @db.Timestamptz(3)
  occurrence   MonthlyExpenseOccurrence @relation(fields: [occurrenceId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([occurrenceId])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  ownerId    String
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.Uuid
  data       Json
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, entityType, entityId])
  @@schema("public")
}

model IdempotencyKey {
  ownerId        String
  key            String   @db.VarChar(80)
  scope          String   @db.VarChar(160)
  requestHash    String   @db.Char(64)
  responseStatus Int?     @db.SmallInt
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, key])
  @@index([createdAt])
  @@schema("public")
}
