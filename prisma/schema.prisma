generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model User {
  id               String                  @id
  name             String
  email            String                  @unique
  emailVerified    Boolean                 @default(false)
  image            String?
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  preferences      UserPreferences?
  notifications    NotificationPreference?
  notificationJobs NotificationJob[]
  expenseSeries    MonthlyExpenseSeries[]
  auditEntries     AuditLog[]
  idempotency      IdempotencyKey[]
  cards            CreditCard[]
  contacts         Contact[]
  invitesSent      UserConnection[]        @relation("ConnectionInviter")
  invitesTaken     UserConnection[]        @relation("ConnectionInvitee")

  @@map("user")
  @@schema("auth")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
  @@schema("auth")
}

model UserPreferences {
  userId    String   @id
  timeZone  String   @default("America/Argentina/Tucuman")
  locale    String   @default("es-AR")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

enum Currency {
  ARS
  USD

  @@schema("public")
}

// DUE/vencido se deriva de dueDate y la fecha del usuario; no se persiste.
enum OccurrenceStatus {
  PLANNED
  PAID
  COVERED
  SKIPPED
  CANCELLED

  @@schema("public")
}

model MonthlyExpenseSeries {
  id             String                     @id @default(uuid(7)) @db.Uuid
  ownerId        String
  name           String                     @db.VarChar(80)
  currency       Currency
  intervalMonths Int                        @default(1) @db.SmallInt
  firstPeriod    DateTime                   @db.Date
  // Último período de la serie cuando se da de baja; null mientras siga vigente.
  endPeriod      DateTime?                  @db.Date
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(3)
  owner          User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  terms          MonthlyExpenseTerms[]
  occurrences    MonthlyExpenseOccurrence[]
  coverages      CoveragePeriod[]

  @@unique([id, ownerId])
  @@index([ownerId, firstPeriod])
  @@schema("public")
}

// Importe y vencimiento vigentes desde effectivePeriod hasta la siguiente versión.
model MonthlyExpenseTerms {
  id              String                     @id @default(uuid(7)) @db.Uuid
  ownerId         String
  seriesId        String                     @db.Uuid
  effectivePeriod DateTime                   @db.Date
  amountMinor     BigInt
  dueDay          Int                        @db.SmallInt
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  series          MonthlyExpenseSeries       @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)
  // Reparto vigente con esta versión; el propietario conserva el porcentaje restante.
  shares          MonthlyExpenseTermsShare[]

  @@unique([seriesId, effectivePeriod])
  @@unique([id, ownerId])
  @@schema("public")
}

model MonthlyExpenseOccurrence {
  id           String                 @id @default(uuid(7)) @db.Uuid
  ownerId      String
  seriesId     String                 @db.Uuid
  period       DateTime               @db.Date
  dueDate      DateTime               @db.Date
  amountMinor  BigInt
  currency     Currency
  status       OccurrenceStatus       @default(PLANNED)
  // Motivo obligatorio para SKIPPED y CANCELLED.
  statusReason String?                @db.VarChar(200)
  coverageId   String?                @db.Uuid
  version      Int                    @default(1)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  series       MonthlyExpenseSeries   @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)
  coverage     CoveragePeriod?        @relation(fields: [coverageId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  payments     ExpensePayment[]
  allocations  OccurrenceAllocation[]

  @@unique([seriesId, period])
  @@unique([id, ownerId])
  @@index([ownerId, period])
  @@schema("public")
}

model ExpensePayment {
  id           String                   @id @default(uuid(7)) @db.Uuid
  ownerId      String
  occurrenceId String                   @db.Uuid
  paidOn       DateTime                 @db.Date
  channel      String?                  @db.VarChar(40)
  amountMinor  BigInt
  currency     Currency
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  revertedAt   DateTime?                @db.Timestamptz(3)
  // Presente cuando el pago es anual y cubre los meses siguientes.
  coverageId   String?                  @db.Uuid
  occurrence   MonthlyExpenseOccurrence @relation(fields: [occurrenceId, ownerId], references: [id, ownerId], onDelete: Cascade)
  coverage     CoveragePeriod?          @relation(fields: [coverageId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurrenceId])
  @@schema("public")
}

// Pago anual: se paga en fromPeriod y cubre hasta toPeriod inclusive.
model CoveragePeriod {
  id          String                     @id @default(uuid(7)) @db.Uuid
  ownerId     String
  seriesId    String                     @db.Uuid
  fromPeriod  DateTime                   @db.Date
  toPeriod    DateTime                   @db.Date
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  revertedAt  DateTime?                  @db.Timestamptz(3)
  series      MonthlyExpenseSeries       @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)
  occurrences MonthlyExpenseOccurrence[]
  payments    ExpensePayment[]

  @@unique([id, ownerId])
  @@index([seriesId, fromPeriod])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  ownerId    String
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.Uuid
  data       Json
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, entityType, entityId])
  @@schema("public")
}

model IdempotencyKey {
  ownerId        String
  key            String   @db.VarChar(80)
  scope          String   @db.VarChar(160)
  requestHash    String   @db.Char(64)
  responseStatus Int?     @db.SmallInt
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, key])
  @@index([createdAt])
  @@schema("public")
}

model Contact {
  id              String                     @id @default(uuid(7)) @db.Uuid
  ownerId         String
  // Apodo privado del propietario; nunca se muestra a la contraparte.
  nickname        String                     @db.VarChar(60)
  email           String?                    @db.VarChar(254)
  connectionId    String?                    @db.Uuid
  archivedAt      DateTime?                  @db.Timestamptz(3)
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(3)
  owner           User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connection      UserConnection?            @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  shares          MonthlyExpenseTermsShare[]
  allocations     OccurrenceAllocation[]
  cardAllocations CardAllocation[]
  debts           PersonalDebt[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@schema("public")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED

  @@schema("public")
}

// Invitación (PENDING) y conexión aceptada entre dos cuentas de GastApp.
model UserConnection {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  inviterId           String
  invitationTokenHash String?                @db.Char(64)
  inviterName         String                 @db.VarChar(120)
  inviteeEmail        String                 @db.VarChar(254)
  inviteeId           String?
  inviteeName         String?                @db.VarChar(120)
  status              ConnectionStatus       @default(PENDING)
  // Período en que se aceptó (informativo): la contraparte ve todo el historial compartido.
  acceptedPeriod      DateTime?              @db.Date
  expiresAt           DateTime               @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  respondedAt         DateTime?              @db.Timestamptz(3)
  inviter             User                   @relation("ConnectionInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee             User?                  @relation("ConnectionInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  contacts            Contact[]
  cardAllocations     CardAllocation[]
  allocations         OccurrenceAllocation[]

  @@index([inviteeEmail, status])
  @@index([inviterId])
  @@index([inviteeId])
  @@schema("public")
}

model MonthlyExpenseTermsShare {
  id        String              @id @default(uuid(7)) @db.Uuid
  ownerId   String
  termsId   String              @db.Uuid
  contactId String              @db.Uuid
  shareBps  Int
  terms     MonthlyExpenseTerms @relation(fields: [termsId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([termsId, contactId])
  @@schema("public")
}

// Snapshot del reparto de una ocurrencia. Sin estado ni pagos propios.
model OccurrenceAllocation {
  id              String                   @id @default(uuid(7)) @db.Uuid
  ownerId         String
  occurrenceId    String                   @db.Uuid
  // null = parte del propietario.
  contactId       String?                  @db.Uuid
  connectionId    String?                  @db.Uuid
  period          DateTime                 @db.Date
  expenseName     String                   @db.VarChar(80)
  shareBps        Int
  baseAmountMinor BigInt
  amountMinor     BigInt
  currency        Currency
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  occurrence      MonthlyExpenseOccurrence @relation(fields: [occurrenceId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact         Contact?                 @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade, onUpdate: NoAction)
  connection      UserConnection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([occurrenceId])
  @@index([ownerId, period])
  @@index([connectionId, period])
  @@schema("public")
}

enum DebtDirection {
  RECEIVABLE
  PAYABLE

  @@schema("public")
}

// Dinero que deben al usuario o que él debe. Independiente de gastos y repartos.
model PersonalDebt {
  direction      DebtDirection            @default(RECEIVABLE)
  id             String                   @id @default(uuid(7)) @db.Uuid
  ownerId        String
  contactId      String                   @db.Uuid
  description    String                   @db.VarChar(120)
  notes          String?                  @db.VarChar(500)
  currency       Currency
  principalMinor BigInt
  lentOn         DateTime                 @db.Date
  dueOn          DateTime?                @db.Date
  // Cancelar perdona el saldo restante sin registrar un pago.
  cancelledAt    DateTime?                @db.Timestamptz(3)
  cancelReason   String?                  @db.VarChar(200)
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  contact        Contact                  @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade, onUpdate: NoAction)
  payments       PersonalDebtPayment[]
  adjustments    PersonalDebtAdjustment[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@schema("public")
}

model PersonalDebtPayment {
  id          String       @id @default(uuid(7)) @db.Uuid
  ownerId     String
  debtId      String       @db.Uuid
  amountMinor BigInt
  paidOn      DateTime     @db.Date
  // Puede registrar que se recibió otra moneda y a qué cambio; GastApp no convierte.
  note        String?      @db.VarChar(300)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  revertedAt  DateTime?    @db.Timestamptz(3)
  debt        PersonalDebt @relation(fields: [debtId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([debtId])
  @@schema("public")
}

enum DebtAdjustmentKind {
  INCREASE
  FORGIVE

  @@schema("public")
}

model PersonalDebtAdjustment {
  id          String             @id @default(uuid(7)) @db.Uuid
  ownerId     String
  debtId      String             @db.Uuid
  kind        DebtAdjustmentKind
  amountMinor BigInt
  effectiveOn DateTime           @db.Date
  reason      String             @db.VarChar(200)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  debt        PersonalDebt       @relation(fields: [debtId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([debtId])
  @@schema("public")
}

// Tarjetas: el cargo esperado es la única fuente de importe de una cuota.
enum CardStatementStatus {
  DRAFT
  RECONCILED
  PAID

  @@schema("public")
}

model CreditCard {
  id         String                @id @default(uuid(7)) @db.Uuid
  ownerId    String
  name       String                @db.VarChar(80)
  lastFour   String?               @db.VarChar(4)
  closingDay Int                   @db.SmallInt
  dueDay     Int                   @db.SmallInt
  archivedAt DateTime?             @db.Timestamptz(3)
  version    Int                   @default(1)
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(3)
  owner      User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purchases  CardPurchase[]
  recurring  CardRecurringSeries[]
  statements CardStatement[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@schema("public")
}

model CardPurchase {
  id                 String       @id @default(uuid(7)) @db.Uuid
  ownerId            String
  cardId             String       @db.Uuid
  description        String       @db.VarChar(120)
  occurredOn         DateTime     @db.Date
  currency           Currency
  // Evidencia de lo ingresado, no se usa para totalizar tras corregir una cuota.
  originalTotalMinor BigInt
  installments       Int          @db.SmallInt
  firstPeriod        DateTime     @db.Date
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  card               CreditCard   @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Cascade)
  charges            CardCharge[]

  @@unique([id, ownerId])
  @@schema("public")
}

model CardRecurringSeries {
  id          String               @id @default(uuid(7)) @db.Uuid
  ownerId     String
  cardId      String               @db.Uuid
  description String               @db.VarChar(120)
  currency    Currency
  firstPeriod DateTime             @db.Date
  endPeriod   DateTime?            @db.Date
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  card        CreditCard           @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Cascade)
  terms       CardRecurringTerms[]
  charges     CardCharge[]

  @@unique([id, ownerId])
  @@schema("public")
}

model CardRecurringTerms {
  id              String              @id @default(uuid(7)) @db.Uuid
  ownerId         String
  seriesId        String              @db.Uuid
  effectivePeriod DateTime            @db.Date
  amountMinor     BigInt
  // Regla futura validada contra contactos propios; cada cargo guarda allocations relacionales.
  shares          Json
  series          CardRecurringSeries @relation(fields: [seriesId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([seriesId, effectivePeriod])
  @@schema("public")
}

model CardStatement {
  id            String               @id @default(uuid(7)) @db.Uuid
  ownerId       String
  cardId        String               @db.Uuid
  period        DateTime             @db.Date
  closingDate   DateTime             @db.Date
  dueDate       DateTime             @db.Date
  status        CardStatementStatus  @default(DRAFT)
  bankArsMinor  BigInt?
  bankUsdMinor  BigInt?
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  card          CreditCard           @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Cascade)
  charges       CardCharge[]
  lines         StatementLine[]
  payments      CardPayment[]
  transfersFrom CardChargeTransfer[] @relation("TransferFrom")
  transfersTo   CardChargeTransfer[] @relation("TransferTo")

  @@unique([cardId, period])
  @@unique([id, ownerId])
  @@index([ownerId, period])
  @@schema("public")
}

model CardCharge {
  id             String               @id @default(uuid(7)) @db.Uuid
  ownerId        String
  statementId    String               @db.Uuid
  purchaseId     String?              @db.Uuid
  recurringId    String?              @db.Uuid
  expectedPeriod DateTime             @db.Date
  installmentNo  Int?                 @db.SmallInt
  description    String               @db.VarChar(120)
  occurredOn     DateTime             @db.Date
  amountMinor    BigInt
  currency       Currency
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  statement      CardStatement        @relation(fields: [statementId, ownerId], references: [id, ownerId], onDelete: Cascade)
  purchase       CardPurchase?        @relation(fields: [purchaseId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  recurring      CardRecurringSeries? @relation(fields: [recurringId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  allocations    CardAllocation[]
  line           StatementLine?
  transfers      CardChargeTransfer[]

  @@unique([id, ownerId])
  @@unique([purchaseId, installmentNo])
  @@unique([recurringId, expectedPeriod])
  @@index([statementId])
  @@schema("public")
}

// Una línea concreta se vincula con un cargo (1:1) o se excluye con motivo.
model StatementLine {
  id           String        @id @default(uuid(7)) @db.Uuid
  ownerId      String
  statementId  String        @db.Uuid
  chargeId     String?       @unique @db.Uuid
  description  String        @db.VarChar(120)
  postedOn     DateTime      @db.Date
  amountMinor  BigInt
  currency     Currency
  ignoreReason String?       @db.VarChar(200)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  statement    CardStatement @relation(fields: [statementId, ownerId], references: [id, ownerId], onDelete: Cascade)
  charge       CardCharge?   @relation(fields: [chargeId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([chargeId, ownerId])
  @@index([statementId])
  @@schema("public")
}

model CardAllocation {
  id              String          @id @default(uuid(7)) @db.Uuid
  ownerId         String
  chargeId        String          @db.Uuid
  contactId       String?         @db.Uuid
  connectionId    String?         @db.Uuid
  contactName     String?         @db.VarChar(60)
  period          DateTime        @db.Date
  expenseName     String          @db.VarChar(120)
  baseAmountMinor BigInt
  amountMinor     BigInt
  shareBps        Int
  currency        Currency
  charge          CardCharge      @relation(fields: [chargeId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact         Contact?        @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  connection      UserConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([ownerId, period])
  @@index([connectionId, period])
  @@schema("public")
}

model CardChargeTransfer {
  id              String        @id @default(uuid(7)) @db.Uuid
  ownerId         String
  chargeId        String        @db.Uuid
  fromStatementId String        @db.Uuid
  toStatementId   String        @db.Uuid
  reason          String        @db.VarChar(200)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  charge          CardCharge    @relation(fields: [chargeId, ownerId], references: [id, ownerId], onDelete: Cascade)
  fromStatement   CardStatement @relation("TransferFrom", fields: [fromStatementId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  toStatement     CardStatement @relation("TransferTo", fields: [toStatementId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model CardPayment {
  id          String        @id @default(uuid(7)) @db.Uuid
  ownerId     String
  statementId String        @db.Uuid
  paidOn      DateTime      @db.Date
  channel     String?       @db.VarChar(40)
  notes       String?       @db.VarChar(500)
  arsMinor    BigInt
  usdMinor    BigInt
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  revertedAt  DateTime?     @db.Timestamptz(3)
  statement   CardStatement @relation(fields: [statementId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([statementId])
  @@schema("public")
}

model NotificationPreference {
  userId       String   @id
  emailEnabled Boolean  @default(false)
  monthly      Boolean  @default(true)
  cards        Boolean  @default(true)
  debts        Boolean  @default(true)
  daysBefore   Int      @default(3) @db.SmallInt
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model NotificationJob {
  id            String    @id @default(uuid(7)) @db.Uuid
  ownerId       String
  kind          String    @db.VarChar(20)
  dedupeKey     String    @unique @db.VarChar(160)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(12)
  attempts      Int       @default(0) @db.SmallInt
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken    String?   @db.Uuid
  leaseUntil    DateTime? @db.Timestamptz(3)
  lastError     String?   @db.VarChar(80)
  sentAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([ownerId, createdAt])
  @@schema("public")
}
