# =====================================================================
# V2 (rama v2) — React Router + Express + Prisma/PostgreSQL + Better Auth
# V2 lee SOLO .env.local (o ENV_FILE); nunca el .env legacy de V1.
# =====================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

# --- PostgreSQL local (Postgres.app, puerto 5555, base gastappv2) ---
POSTGRES_USER=gastapp_owner
POSTGRES_DB=gastappv2
POSTGRES_PASSWORD=generated-by-setup
AUTH_DB_PASSWORD=generated-by-setup
APP_DB_PASSWORD=generated-by-setup
POSTGRES_PORT=5555
MIGRATION_DATABASE_URL=postgresql://gastapp_owner:generated-by-setup@127.0.0.1:5555/gastappv2
AUTH_DATABASE_URL=postgresql://gastapp_auth:generated-by-setup@127.0.0.1:5555/gastappv2
DATABASE_URL=postgresql://gastapp_app:generated-by-setup@127.0.0.1:5555/gastappv2

# --- Auth (Better Auth + Google) ---
# El nombre GOOGLE_CLIENT_ID/SECRET es el mismo que en V1: se puede reutilizar
# el cliente OAuth si en Google Cloud se agrega el redirect URI de V2:
#   {APP_ORIGIN}/api/auth/callback/google
BETTER_AUTH_SECRET=generated-by-setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Worker (avisos por email de vencimientos, invitaciones) ---
# Rol PostgreSQL propio. Se completa con setup:local y db:setup.
WORKER_DB_PASSWORD=generated-by-setup
WORKER_DATABASE_URL=postgresql://gastapp_worker:generated-by-setup@127.0.0.1:5555/gastappv2

# --- Correo ---
# capture: guarda los mails en MAIL_CAPTURE_DIR (no salen a Internet).
# smtp: envía de verdad. Para Gmail:
#   1) Activar verificación en 2 pasos en la cuenta.
#   2) Crear una "contraseña de aplicación": https://myaccount.google.com/apppasswords
#   3) Pegarla en SMTP_PASSWORD (sin espacios), poner SMTP_USER y MAIL_FROM
#      con el mismo email de Gmail y cambiar MAIL_MODE=smtp.
#   4) En la app: Cuenta → avisos por email → activar. Correr el worker (npm run worker:dev).
MAIL_MODE=capture
MAIL_FROM=noreply@example.test
MAIL_CAPTURE_DIR=.data/mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# --- Backups ---
# Se guarda por separado de los backups. Nunca subirla a Git.
BACKUP_ENCRYPTION_KEY=generated-by-setup
# POSTGRES_BIN=/Applications/Postgres.app/Contents/Versions/18/bin

# =====================================================================
# V1 (legacy, Next.js) — variables que usa la app anterior (rama main/develop)
# V2 NO las usa. GOOGLE_CLIENT_ID/SECRET se comparten con el bloque V2 y
# DATABASE_URL de V1 es otra base (en V2 es la de .env.local).
# =====================================================================
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# V1 (comparten nombre con V2, ver arriba): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# V1: correo con el que envía avisos
MAILER_USER=
MAILER_PASSWORD=
GMAIL_INVOICE_MAILER=

# V1: protege los endpoints de cron
CRON_SECRET=

# V1: base de datos y cifrado
# DATABASE_URL=   (V1; en V2 está arriba)
CRYPTO_SECRET=

# PROD (V1)
# DATABASE_URL=
# CRYPTO_SECRET=
