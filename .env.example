# V2 reads only .env.local (or ENV_FILE), never the legacy .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
POSTGRES_USER=gastapp_owner
POSTGRES_DB=gastappv2
POSTGRES_PASSWORD=generated-by-setup
AUTH_DB_PASSWORD=generated-by-setup
APP_DB_PASSWORD=generated-by-setup
POSTGRES_PORT=5555
MIGRATION_DATABASE_URL=postgresql://gastapp_owner:generated-by-setup@127.0.0.1:5555/gastappv2
AUTH_DATABASE_URL=postgresql://gastapp_auth:generated-by-setup@127.0.0.1:5555/gastappv2
DATABASE_URL=postgresql://gastapp_app:generated-by-setup@127.0.0.1:5555/gastappv2
BETTER_AUTH_SECRET=generated-by-setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker con permisos propios. Completar con setup:local y db:setup.
WORKER_DB_PASSWORD=generated-by-setup
WORKER_DATABASE_URL=postgresql://gastapp_worker:generated-by-setup@127.0.0.1:5555/gastappv2
# Desarrollo: los correos quedan en archivos privados; no salen a Internet.
MAIL_MODE=capture
MAIL_CAPTURE_DIR=.data/mail
MAIL_FROM=noreply@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Se guarda por separado de los backups. Nunca subirla a Git.
BACKUP_ENCRYPTION_KEY=generated-by-setup
# POSTGRES_BIN=/Applications/Postgres.app/Contents/Versions/18/bin
